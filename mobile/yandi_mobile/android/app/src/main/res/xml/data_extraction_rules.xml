<?xml version="1.0" encoding="utf-8"?>
<!-- Ничего из приложения не уходит ни в облачную резервную копию, ни при переносе на другой телефон:
     база чатов, ключи и файлы остаются только в песочнице этого устройства. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
